# Copy to .env (git-ignored). Read by docker compose AND by the Python tools.
STACK_VERSION=9.5.5
ELASTIC_PASSWORD=change-me-elastic
KIBANA_SYSTEM_PASSWORD=change-me-kibana-system
# 32+ characters. Never change it once rules exist, or every rule must be restarted:
#   python -c "import secrets; print(secrets.token_hex(16))"
KIBANA_ENCRYPTION_KEY=
ES_HEAP=1g

# Python tools (defaults shown)
# ES_URL=http://localhost:9200
# KIBANA_URL=http://localhost:5601
# ELASTIC_USERNAME=elastic
# ELASTIC_API_KEY=                 # preferred over username/password for deploys

# AI judge
# JUDGE_PROVIDER=ollama            # ollama | openai_compat | replay
# JUDGE_MODEL=gemma4:e4b
# OLLAMA_HOST=http://localhost:11434
# JUDGE_BASE_URL=https://models.github.ai/inference   # for openai_compat
# JUDGE_API_KEY=
